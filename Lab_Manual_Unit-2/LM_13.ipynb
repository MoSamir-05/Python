   "source": [
    "### Find the length of the list and simply swap the first element with (n-1)th element."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e0d6fe0f-1af3-442d-a98d-1c0221f13918",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Length of list: 5\n",
      "List after swapping: [50, 20, 30, 40, 10]\n"
     ]
    }
   ],
   "source": [
    "my_list = [10, 20, 30, 40, 50]\n",
    "n = len(my_list)\n",
    "print(\"Length of list:\", n)\n",
    "my_list[0], my_list[n-1] = my_list[n-1], my_list[0]\n",
    "print(\"List after swapping:\", my_list)"
   ]
  },
