    "sr=input(\"Enter any words : \")\n",
    "vowel=[\"a\",\"e\",\"i\",\"o\",\"u\"]\n",
    "co=0\n",
    "for i in sr.lower():\n",
    "    if(i in vowel):\n",
    "        co+=1\n",
    "print(co)"
