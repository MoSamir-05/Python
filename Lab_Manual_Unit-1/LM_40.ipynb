   "source": [
    "###  Write a program to count the numbers of characters in the string and store them in a dictionary data structure."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "94644084-2204-4f4b-8201-2f465c42730a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a string:  samir\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Character counts: Counter({'s': 1, 'a': 1, 'm': 1, 'i': 1, 'r': 1})\n"
     ]
    }
   ],
   "source": [
    "from collections import Counter\n",
    "text = input(\"Enter a string: \")\n",
    "\n",
    "char_count = Counter(text)\n",
    "\n",
    "print(\"Character counts:\", char_count)\n"
   ]
  },
