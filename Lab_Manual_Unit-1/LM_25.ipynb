   ],
   "source": [
    "num1=int(input(\"Enter Number : \"))\n",
    "st=str(num1)\n",
    "rev=st[::-1]\n",
    "if st==rev:\n",
    "    print(num1,\"Is Palindrome\")\n",
    "else:\n",
    "    print(num1,\"Is not Palindrome\")"
   ]
